# توکن ربات که از @BotFather می‌گیرید
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# همان اطلاعات اتصال دیتابیس turso که در پروژهٔ اسکرِیپر استفاده می‌کنید
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# یک رشتهٔ تصادفی دلخواه؛ فقط باید بین اینجا و set_webhook.py یکسان باشد
WEBHOOK_SECRET=change-this-to-a-random-string
